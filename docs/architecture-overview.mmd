flowchart LR
	subgraph Runtime[Runtime entry points]
		Launcher["unified_launcher"]
		Supervisor["collector_supervisor"]
		Main["main.py<br/>CLI and collector entry"]
		API["api.app<br/>Dashboard and sync API"]
	end

	subgraph Collection[Activity collection]
		Collector["collector_service"]
		Window["window_tracker"]
		Browser["browser_tracker"]
		Idle["idle_tracker"]
		Git["git_tracker"]
		Builder["session_builder"]
		Tagger["activity_tagger"]
	end

	subgraph Wellbeing[Wellbeing services]
		WellbeingService["wellbeing"]
		Delivery["wellbeing_delivery"]
		UI["wellbeing_ui"]
	end

	subgraph Sync[Sync client services]
		Daemon["sync_daemon"]
		Worker["sync_worker<br/>HTTP client"]
	end

	subgraph Shared[Shared data and services]
		Repository["db.repository<br/>ActivityRepository"]
		Schema["db/schema.sql"]
		SyncConfig["sync_config"]
		SyncManifest["config/sync.yaml"]
		Reporting["reporting"]
		TagReview["tag_review"]
		TagMigration["tag_migration<br/>maintenance helper"]
	end

	LocalDB[("Client SQLite database")]
	ServerDB[("Server SQLite database")]
	BrowserUI["Dashboard, timeline,<br/>journal and review pages"]

	Launcher -->|starts and supervises| Supervisor
	Supervisor -->|restarts| Main
	Launcher -->|starts| API
	Launcher -.->|when configured| Daemon
	Main -->|CLI sync commands| Daemon
	Main -->|one-shot sync commands| Worker

	Main --> Collector
	Main --> Reporting
	Main -->|wellbeing control| Delivery
	Collector --> Window & Browser & Idle & Git
	Collector --> Builder
	Collector --> Tagger
	Collector --> Repository
	Builder -->|completed sessions| Collector

	Collector --> WellbeingService
	WellbeingService -->|notification and speech callbacks| Delivery
	Collector -->|desktop prompt delivery| Delivery
	Collector --> UI
	UI -->|user actions| Collector
	Delivery -->|queued actions and control-file requests| Collector
	Launcher -.->|restart/error signal| Delivery
	Supervisor -.->|error signal| Delivery

	Daemon --> Worker
	Worker --> Repository
	Worker <-->|authenticated push and pull| API
	Repository -->|local data| LocalDB
	Schema -.->|defines local schema| LocalDB
	Repository --> SyncConfig
	API --> SyncConfig
	SyncConfig --> SyncManifest

	BrowserUI <-->|HTTP| API
	API -->|local mode| LocalDB
	API -->|sync-server mode| ServerDB
	API --> Repository
	API --> Tagger & TagReview & Reporting
	Reporting -->|configured data source| LocalDB & ServerDB
	Main -->|health provider| Reporting
	API -->|health provider| Reporting
	Repository --> TagReview
	TagMigration --> Tagger
	TagMigration --> Repository